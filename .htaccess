RewriteEngine On
RewriteBase /

RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|meta-webindexer|Applebot) [NC]
RewriteRule ^ - [F,L]

RewriteRule ^page/(.*)$ $1 [L,R=301]
RewriteRule ^components/(.*)$ $1 [L,R=301]
RewriteRule ^layout/(.*)$ $1 [L,R=301]
RewriteRule ^other/(.*)$ $1 [L,R=301]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !\.\w{2,4}$
RewriteRule ^(.*)/$ $1/index [L,R=301]

RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /yanis/(.*)\.php\ HTTP/
RewriteRule ^(.*)\.php$ $1 [R=301,L]

RewriteRule ^$ index [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^url/(.+)$ index.php?url=$1 [L,QSA,NC]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?url=$1 [L,QSA,NC]